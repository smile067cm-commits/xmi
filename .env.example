# ==============================================================================
# 🔐 CLOUDFLARE WORKER / BOT ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================

# 1. Telegram Bot Token (Get from @BotFather on Telegram)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Your Telegram Numeric User ID (Get from @userinfobot or @JsonDumpBot)
ADMIN_ID=123456789

# 3. Private Storage Channel ID (e.g. -1001234567890 where bot is Admin)
CHANNEL_ID=-1001234567890

# 4. Supabase Project REST URL (Find in Supabase: Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# 5. Supabase Service Role Key (Find in Supabase: Project Settings -> API -> service_role secret)
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# 6. Telegram Bot Username without '@' (e.g. MySuperContentBot)
BOT_USERNAME=YourTelegramBot

# 7. (Optional) Custom Web App / Worker URL
WEB_APP_URL=https://telegram-bot-hub.yoursubdomain.workers.dev

# 8. (Optional) Webhook Secret Token for extra security
SECRET_TOKEN=my_custom_secret_token_123
