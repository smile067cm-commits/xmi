# =========================================================
# Environment Variables & Secrets Reference
# Use `npx wrangler secret put <KEY>` to set these in Cloudflare
# =========================================================

# 1. Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Telegram Numeric User ID of the Bot Administrator
ADMIN_ID=123456789

# 3. Numeric ID of the private Telegram Channel for storing files (e.g. -1001234567890)
CHANNEL_ID=-1001234567890

# 4. Firebase Realtime Database URL
FIREBASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# 5. Firebase Realtime Database Secret / Auth Token
FIREBASE_SECRET=your_firebase_database_secret_here

# 6. Supabase Project REST URL
SUPABASE_URL=https://your-project-ref.supabase.co

# 7. Supabase Service Role Secret Key (Allows full read/write from Cloudflare Worker)
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# 8. Web App Frontend URL (e.g., Cloudflare Pages URL)
WEB_APP_URL=https://your-frontend-app.pages.dev

# 9. (Optional) Custom Secret Token for Webhook Verification
SECRET_TOKEN=my_custom_webhook_secret_123
